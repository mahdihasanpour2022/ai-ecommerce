{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist-test",
    "noEmit": false,
    "incremental": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "app/http/api-response.ts",
    "app/http/http-client.ts",
    "app/http/server-api.ts",
    "constants/appRoues.ts",
