{
  "name": "@automotive-commerce/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "tsc --project tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\""
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/node": "24.10.13",
    "@types/supertest": "7.2.1",
    "eslint": "10.9.1",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  },
  "engines": {
    "node": ">=20.11"
  }
