# Safe reference values. The API reads its process environment directly.
NODE_ENV=development
PORT=3002

# Prisma CLI and trusted provisioning connection contracts.
DATABASE_URL=postgresql://automotive:automotive_local_only@localhost:5432/automotive_dev?schema=public
TEST_DATABASE_URL=postgresql://automotive:automotive_local_only@localhost:5432/automotive_test?schema=public

# One-shot ADMIN_BOOTSTRAP_* provisioning values are intentionally omitted.
# Supply them only through the trusted process contract documented in docs/development/admin-provisioning.md.

# Backend login lifetimes and exact development browser origin.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_REUSE_GRACE_SECONDS=10
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Application-owned local Product Image storage. Development/test only; production media fails closed.
PRODUCT_IMAGE_STORAGE_ROOT=./tmp/product-images

# Login password and throttle policy (accepted defaults).
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_PARALLELISM=1
AUTH_LOGIN_ACCOUNT_FAILURE_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_INITIAL_DELAY_SECONDS=30
AUTH_LOGIN_MAX_DELAY_SECONDS=900
AUTH_LOGIN_IP_LIMIT=20
AUTH_REFRESH_SESSION_LIMIT_PER_MINUTE=10
AUTH_REFRESH_IP_LIMIT_PER_MINUTE=30

# Required runtime secrets are intentionally invalid placeholders.
# PEM values may contain literal newlines or escaped \n; the public ring is a JSON object keyed by kid.
AUTH_JWT_ACTIVE_KID=replace-with-active-key-id
AUTH_JWT_PRIVATE_KEY=<required-ed25519-pkcs8-pem>
AUTH_JWT_PUBLIC_KEYS=<required-json-ed25519-spki-keyring>
AUTH_LOGIN_THROTTLE_HMAC_KEY=<required-base64-32-byte-random-key>
AUTH_CSRF_ACTIVE_KID=replace-with-active-csrf-key-id
AUTH_CSRF_HMAC_KEYS=<required-json-base64-csrf-hmac-keyring>
AUTH_REFRESH_RECOVERY_KEYRING=<required-json-active-kid-and-base64-aes-256-gcm-keyring>

# Optional exact JWT identity values.
AUTH_JWT_ISSUER=automotive-commerce-api
AUTH_JWT_AUDIENCE=automotive-commerce-admin
