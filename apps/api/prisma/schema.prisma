generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum ProductImageMediaType {
  WEBP
  JPEG
  PNG

  @@map("product_image_media_type")
}

enum PriceDisplayUnit {
  RIAL
  TOMAN

  @@map("price_display_unit")
}

enum CustomerOtpDeliveryStatus {
  PENDING
  ACCEPTED
  FAILED
  UNKNOWN

  @@map("customer_otp_delivery_status")
}

enum OrderStatus {
  PENDING
  FULFILLED
  CANCELLED
  FAILED

  @@map("order_status")
}

enum OrderItemStatus {
  PENDING
  FULFILLED
  CANCELLED
  FAILED

  @@map("order_item_status")
}

model AdminUser {
  id           String          @id(map: "admin_users_pkey") @default(uuid()) @db.Uuid
  email        String          @unique(map: "admin_users_email_key") @db.VarChar(254)
  username     String          @unique(map: "admin_users_username_key") @db.VarChar(20)
  displayName  String          @map("display_name") @db.VarChar(120)
  passwordHash String          @map("password_hash") @db.VarChar(255)
  disabledAt   DateTime?       @map("disabled_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles        AdminUserRole[]
  sessions     AuthSession[]

  @@map("admin_users")
}

model Role {
  id          String           @id(map: "roles_pkey") @default(uuid()) @db.Uuid
  code        String           @unique(map: "roles_code_key") @db.VarChar(64)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  adminUsers  AdminUserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String           @id(map: "permissions_pkey") @default(uuid()) @db.Uuid
  code      String           @unique(map: "permissions_code_key") @db.VarChar(128)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles     RolePermission[]

  @@map("permissions")
}

model AdminUserRole {
  adminUserId String    @map("admin_user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  assignedAt  DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "admin_user_roles_admin_user_id_fkey")
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "admin_user_roles_role_id_fkey")

  @@id([adminUserId, roleId], map: "admin_user_roles_pkey")
  @@index([roleId], map: "admin_user_roles_role_id_idx")
  @@map("admin_user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  grantedAt    DateTime   @default(now()) @map("granted_at") @db.Timestamptz(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_permissions_role_id_fkey")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "role_permissions_permission_id_fkey")

  @@id([roleId, permissionId], map: "role_permissions_pkey")
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}

model AuthSession {
  id              String                      @id(map: "auth_sessions_pkey") @default(uuid()) @db.Uuid
  adminUserId     String                      @map("admin_user_id") @db.Uuid
  csrfTokenHash   Bytes                       @map("csrf_token_hash") @db.ByteA
  expiresAt       DateTime                    @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime?                   @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt      DateTime                    @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  adminUser       AdminUser                   @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "auth_sessions_admin_user_id_fkey")
  refreshTokens   RefreshToken[]
  refreshThrottle AuthSessionRefreshThrottle?

  @@index([adminUserId, revokedAt, expiresAt], map: "auth_sessions_admin_user_revoked_expires_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model RefreshToken {
  id                 String         @id(map: "refresh_tokens_pkey") @default(uuid()) @db.Uuid
  sessionId          String         @map("session_id") @db.Uuid
  tokenHash          Bytes          @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.ByteA
  expiresAt          DateTime       @map("expires_at") @db.Timestamptz(3)
  rotatedAt          DateTime?      @map("rotated_at") @db.Timestamptz(3)
  revokedAt          DateTime?      @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId  String?        @map("replaced_by_token_id") @db.Uuid
  recoveryCiphertext Bytes?         @map("recovery_ciphertext") @db.ByteA
  recoveryNonce      Bytes?         @map("recovery_nonce") @db.ByteA
  recoveryAuthTag    Bytes?         @map("recovery_auth_tag") @db.ByteA
  recoveryKeyId      String?        @map("recovery_key_id") @db.VarChar(128)
  recoveryExpiresAt  DateTime?      @map("recovery_expires_at") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  session            AuthSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "refresh_tokens_session_id_fkey")
  replacement        RefreshToken?  @relation("RefreshReplacement", fields: [replacedByTokenId, sessionId], references: [id, sessionId], onDelete: NoAction, onUpdate: NoAction, map: "refresh_tokens_replacement_fkey")
  replacedTokens     RefreshToken[] @relation("RefreshReplacement")

  @@unique([id, sessionId], map: "refresh_tokens_id_session_id_key")
  @@unique([replacedByTokenId, sessionId], map: "refresh_tokens_replacement_session_key")
  @@index([sessionId, createdAt], map: "refresh_tokens_session_created_at_idx")
  @@index([expiresAt], map: "refresh_tokens_expires_at_idx")
  @@index([recoveryExpiresAt], map: "refresh_tokens_recovery_expires_at_idx")
  @@map("refresh_tokens")
}

model AdminLoginThrottle {
  identifierKey   Bytes     @id(map: "admin_login_throttles_pkey") @map("identifier_key") @db.ByteA
  windowStartedAt DateTime? @map("window_started_at") @db.Timestamptz(3)
  failureCount    Int       @default(0) @map("failure_count")
  delayUntil      DateTime? @map("delay_until") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt], map: "admin_login_throttles_updated_at_idx")
  @@map("admin_login_throttles")
}

model AuthSessionRefreshThrottle {
  sessionId       String      @id(map: "auth_session_refresh_throttles_pkey") @map("session_id") @db.Uuid
  windowStartedAt DateTime?   @map("window_started_at") @db.Timestamptz(3)
  attemptCount    Int         @default(0) @map("attempt_count")
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  session         AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "auth_session_refresh_throttles_session_id_fkey")

  @@map("auth_session_refresh_throttles")
}

model Customer {
  id            String                 @id(map: "customers_pkey") @default(uuid()) @db.Uuid
  mobile        String                 @unique(map: "customers_mobile_key") @db.VarChar(13)
  firstName     String                 @map("first_name") @db.VarChar(50)
  lastName      String                 @map("last_name") @db.VarChar(50)
  disabledAt    DateTime?              @map("disabled_at") @db.Timestamptz(3)
  lastLoginAt   DateTime?              @map("last_login_at") @db.Timestamptz(3)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      CustomerAuthSession[]
  favoriteItems CustomerFavoriteItem[]
  orders        Order[]

  @@map("customers")
}

/// واقعیت پایدار چرخهٔ سفارش را برای تصمیم‌های وابسته به سابقهٔ خرید نگه می‌دارد.
model Order {
  id         String      @id(map: "orders_pkey") @default(uuid()) @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  status     OrderStatus @default(PENDING) @map("status")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "orders_customer_id_fkey")
  items      OrderItem[]

  @@index([customerId, status], map: "orders_customer_id_status_idx")
  @@map("orders")
}

/// کمیت‌های fulfil‌شده و خنثی‌شده را بدون امکان کسر دوباره ثبت می‌کند.
model OrderItem {
  id                String          @id(map: "order_items_pkey") @default(uuid()) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  variantId         String          @map("variant_id") @db.Uuid
  status            OrderItemStatus @default(PENDING) @map("status")
  fulfilledQuantity Int             @default(0) @map("fulfilled_quantity")
  refundedQuantity  Int             @default(0) @map("refunded_quantity")
  returnedQuantity  Int             @default(0) @map("returned_quantity")
  fulfilledAt       DateTime?       @map("fulfilled_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "order_items_order_id_fkey")
  variant           ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "order_items_variant_id_fkey")

  @@index([orderId, variantId], map: "order_items_order_id_variant_id_idx")
  @@map("order_items")
}

model CustomerOtpChallenge {
  id                 String                     @id(map: "customer_otp_challenges_pkey") @default(uuid()) @db.Uuid
  flowTokenHash      Bytes                      @unique(map: "customer_otp_challenges_flow_token_hash_key") @map("flow_token_hash") @db.ByteA
  mobile             String                     @db.VarChar(13)
  otpDigest          Bytes                      @map("otp_digest") @db.ByteA
  clientReferenceId  String                     @unique(map: "customer_otp_challenges_client_reference_id_key") @map("client_reference_id") @db.Uuid
  deliveryStatus     CustomerOtpDeliveryStatus  @default(PENDING) @map("delivery_status")
  expiresAt          DateTime                   @map("expires_at") @db.Timestamptz(3)
  resendAvailableAt  DateTime                   @map("resend_available_at") @db.Timestamptz(3)
  failedAttemptCount Int                        @default(0) @map("failed_attempt_count")
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz(3)
  invalidatedAt      DateTime?                  @map("invalidated_at") @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  registrationGrant  CustomerRegistrationGrant?

  @@index([mobile, createdAt], map: "customer_otp_challenges_mobile_created_at_idx")
  @@index([expiresAt], map: "customer_otp_challenges_expires_at_idx")
  @@map("customer_otp_challenges")
}

model CustomerRegistrationGrant {
  id            String               @id(map: "customer_registration_grants_pkey") @default(uuid()) @db.Uuid
  challengeId   String               @unique(map: "customer_registration_grants_challenge_id_key") @map("challenge_id") @db.Uuid
  flowTokenHash Bytes                @unique(map: "customer_registration_grants_flow_token_hash_key") @map("flow_token_hash") @db.ByteA
  expiresAt     DateTime             @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime?            @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime?            @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  challenge     CustomerOtpChallenge @relation(fields: [challengeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "customer_registration_grants_challenge_id_fkey")

  @@index([expiresAt], map: "customer_registration_grants_expires_at_idx")
  @@map("customer_registration_grants")
}

model CustomerAuthSession {
  id              String                              @id(map: "customer_auth_sessions_pkey") @default(uuid()) @db.Uuid
  customerId      String                              @map("customer_id") @db.Uuid
  csrfTokenHash   Bytes                               @map("csrf_token_hash") @db.ByteA
  expiresAt       DateTime                            @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime?                           @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt      DateTime                            @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt       DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer        Customer                            @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "customer_auth_sessions_customer_id_fkey")
  refreshTokens   CustomerRefreshToken[]
  refreshThrottle CustomerAuthSessionRefreshThrottle?

  @@index([customerId, revokedAt, expiresAt], map: "customer_auth_sessions_customer_revoked_expires_idx")
  @@index([expiresAt], map: "customer_auth_sessions_expires_at_idx")
  @@map("customer_auth_sessions")
}

model CustomerRefreshToken {
  id                 String                 @id(map: "customer_refresh_tokens_pkey") @default(uuid()) @db.Uuid
  sessionId          String                 @map("session_id") @db.Uuid
  tokenHash          Bytes                  @unique(map: "customer_refresh_tokens_token_hash_key") @map("token_hash") @db.ByteA
  expiresAt          DateTime               @map("expires_at") @db.Timestamptz(3)
  rotatedAt          DateTime?              @map("rotated_at") @db.Timestamptz(3)
  revokedAt          DateTime?              @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId  String?                @map("replaced_by_token_id") @db.Uuid
  recoveryCiphertext Bytes?                 @map("recovery_ciphertext") @db.ByteA
  recoveryNonce      Bytes?                 @map("recovery_nonce") @db.ByteA
  recoveryAuthTag    Bytes?                 @map("recovery_auth_tag") @db.ByteA
  recoveryKeyId      String?                @map("recovery_key_id") @db.VarChar(128)
  recoveryExpiresAt  DateTime?              @map("recovery_expires_at") @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  session            CustomerAuthSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_refresh_tokens_session_id_fkey")
  replacement        CustomerRefreshToken?  @relation("CustomerRefreshReplacement", fields: [replacedByTokenId, sessionId], references: [id, sessionId], onDelete: NoAction, onUpdate: NoAction, map: "customer_refresh_tokens_replacement_fkey")
  replacedTokens     CustomerRefreshToken[] @relation("CustomerRefreshReplacement")

  @@unique([id, sessionId], map: "customer_refresh_tokens_id_session_id_key")
  @@unique([replacedByTokenId, sessionId], map: "customer_refresh_tokens_replacement_session_key")
  @@index([sessionId, createdAt], map: "customer_refresh_tokens_session_created_at_idx")
  @@index([expiresAt], map: "customer_refresh_tokens_expires_at_idx")
  @@index([recoveryExpiresAt], map: "customer_refresh_tokens_recovery_expires_at_idx")
  @@map("customer_refresh_tokens")
}

model CustomerOtpMobileThrottle {
  mobileKey Bytes    @id(map: "customer_otp_mobile_throttles_pkey") @map("mobile_key") @db.ByteA
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt], map: "customer_otp_mobile_throttles_updated_at_idx")
  @@map("customer_otp_mobile_throttles")
}

model CustomerAuthSessionRefreshThrottle {
  sessionId       String              @id(map: "customer_auth_session_refresh_throttles_pkey") @map("session_id") @db.Uuid
  windowStartedAt DateTime?           @map("window_started_at") @db.Timestamptz(3)
  attemptCount    Int                 @default(0) @map("attempt_count")
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  session         CustomerAuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_auth_session_refresh_throttles_session_id_fkey")

  @@map("customer_auth_session_refresh_throttles")
}

model Category {
  id        String         @id(map: "categories_pkey") @default(uuid()) @db.Uuid
  name      String         @db.VarChar(120)
  nameKey   String         @map("name_key") @db.VarChar(256)
  parentId  String?        @map("parent_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent    Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "categories_parent_id_fkey")
  children  Category[]     @relation("CategoryTree")
  products  Product[]
  image     CategoryImage?

  @@unique([parentId, nameKey], map: "categories_parent_id_name_key_key")
  @@map("categories")
}

model CategoryImage {
  id         String                @id(map: "category_images_pkey") @default(uuid()) @db.Uuid
  categoryId String                @unique(map: "category_images_category_id_key") @map("category_id") @db.Uuid
  storageKey String                @unique(map: "category_images_storage_key_key") @map("storage_key") @db.VarChar(512)
  mediaType  ProductImageMediaType @map("media_type")
  byteSize   Int                   @map("byte_size")
  width      Int
  height     Int
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  category   Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "category_images_category_id_fkey")

  @@map("category_images")
}

model CategoryImageCleanup {
  id              String    @id(map: "category_image_cleanups_pkey") @default(uuid()) @db.Uuid
  storageKey      String    @unique(map: "category_image_cleanups_storage_key_key") @map("storage_key") @db.VarChar(512)
  attemptCount    Int       @default(0) @map("attempt_count")
  lastAttemptAt   DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastFailureCode String?   @map("last_failure_code") @db.VarChar(64)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt, id], map: "category_image_cleanups_created_id_idx")
  @@map("category_image_cleanups")
}

model Banner {
  id         String                @id(map: "banners_pkey") @default(uuid()) @db.Uuid
  altText    String?               @map("alt_text") @db.VarChar(160)
  storageKey String                @unique(map: "banners_storage_key_key") @map("storage_key") @db.VarChar(512)
  mediaType  ProductImageMediaType @map("media_type")
  byteSize   Int                   @map("byte_size")
  width      Int
  height     Int
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt, id], map: "banners_created_id_idx")
  @@map("banners")
}

model BannerImageCleanup {
  id              String    @id(map: "banner_image_cleanups_pkey") @default(uuid()) @db.Uuid
  storageKey      String    @unique(map: "banner_image_cleanups_storage_key_key") @map("storage_key") @db.VarChar(512)
  attemptCount    Int       @default(0) @map("attempt_count")
  lastAttemptAt   DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastFailureCode String?   @map("last_failure_code") @db.VarChar(64)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt, id], map: "banner_image_cleanups_created_id_idx")
  @@map("banner_image_cleanups")
}

model Product {
  id                String                 @id(map: "products_pkey") @default(uuid()) @db.Uuid
  name              String                 @db.VarChar(200)
  description       String?                @db.Text
  tag               String?                @db.VarChar(80)
  originalPriceRial BigInt                 @map("original_price_rial") @db.BigInt
  discountPercent   Int                    @default(0) @map("discount_percent")
  categoryId        String                 @map("category_id") @db.Uuid
  status            ProductStatus          @default(DRAFT)
  imageVersion      Int                    @default(1) @map("image_version")
  specifications    Json                   @default("{}") @db.JsonB
  mainSpecKeys      String[]               @default([]) @map("main_spec_keys")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  category          Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "products_category_id_fkey")
  variants          ProductVariant[]
  images            ProductImage[]
  favoriteItems     CustomerFavoriteItem[]

  @@index([updatedAt(sort: Desc), id(sort: Desc)], map: "products_updated_id_idx")
  @@index([categoryId, updatedAt(sort: Desc), id(sort: Desc)], map: "products_category_updated_id_idx")
  @@index([status, updatedAt(sort: Desc), id(sort: Desc)], map: "products_status_updated_id_idx")
  @@index([categoryId, status, updatedAt(sort: Desc), id(sort: Desc)], map: "products_category_status_updated_id_idx")
  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "products_status_created_id_idx")
  @@index([categoryId, status, createdAt(sort: Desc), id(sort: Desc)], map: "products_category_status_created_id_idx")
  @@index([status, tag, createdAt(sort: Desc), id(sort: Desc)], map: "products_status_tag_created_id_idx")
  @@map("products")
}

// پیوند علاقه‌مندی را برای هر مشتری و محصول یکتا و قابل مرتب‌سازی نگه می‌دارد.
model CustomerFavoriteItem {
  customerId String   @map("customer_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_favorite_items_customer_id_fkey")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_favorite_items_product_id_fkey")

  @@id([customerId, productId], map: "customer_favorite_items_pkey")
  @@index([customerId, createdAt(sort: Desc), productId(sort: Desc)], map: "customer_favorite_items_customer_created_product_idx")
  @@index([productId], map: "customer_favorite_items_product_id_idx")
  @@map("customer_favorite_items")
}

model ProductVariant {
  id         String        @id(map: "product_variants_pkey") @default(uuid()) @db.Uuid
  productId  String        @map("product_id") @db.Uuid
  sku        String        @unique(map: "product_variants_sku_key") @db.VarChar(64)
  size       String?       @db.VarChar(80)
  sizeKey    String?       @map("size_key") @db.VarChar(160)
  color      String?       @db.VarChar(80)
  colorKey   String?       @map("color_key") @db.VarChar(160)
  isActive   Boolean       @default(true) @map("is_active")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "product_variants_product_id_fkey")
  inventory  Inventory?
  image      ProductImage?
  orderItems OrderItem[]

  @@unique([productId, sizeKey, colorKey], map: "product_variants_product_size_color_key")
  @@index([productId, isActive, id], map: "product_variants_product_active_id_idx")
  @@map("product_variants")
}

model ProductColorOption {
  englishName String   @id(map: "product_color_options_pkey") @map("english_name") @db.VarChar(80)
  persianName String   @unique(map: "product_color_options_persian_name_key") @map("persian_name") @db.VarChar(80)
  hexCode     String   @map("hex_code") @db.Char(7)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("product_color_options")
}

model ProductSizeOption {
  englishName String   @id(map: "product_size_options_pkey") @map("english_name") @db.VarChar(80)
  persianName String   @unique(map: "product_size_options_persian_name_key") @map("persian_name") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("product_size_options")
}

model ProductTagOption {
  englishName String   @id(map: "product_tag_options_pkey") @map("english_name") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("product_tag_options")
}

model Inventory {
  variantId      String         @id(map: "inventories_pkey") @map("variant_id") @db.Uuid
  onHandQuantity Int            @default(0) @map("on_hand_quantity")
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "inventories_variant_id_fkey")

  @@map("inventories")
}

model ProductImage {
  id         String                @id(map: "product_images_pkey") @default(uuid()) @db.Uuid
  productId  String                @map("product_id") @db.Uuid
  variantId  String?               @unique(map: "product_images_variant_id_key") @map("variant_id") @db.Uuid
  storageKey String                @unique(map: "product_images_storage_key_key") @map("storage_key") @db.VarChar(512)
  mediaType  ProductImageMediaType @map("media_type")
  byteSize   Int                   @map("byte_size")
  width      Int
  height     Int
  position   Int                   @db.SmallInt
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  product    Product               @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "product_images_product_id_fkey")
  variant    ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "product_images_variant_id_fkey")

  @@unique([productId, position], map: "product_images_product_id_position_key")
  @@map("product_images")
}

model ProductImageCleanup {
  id              String    @id(map: "product_image_cleanups_pkey") @default(uuid()) @db.Uuid
  storageKey      String    @unique(map: "product_image_cleanups_storage_key_key") @map("storage_key") @db.VarChar(512)
  attemptCount    Int       @default(0) @map("attempt_count")
  lastAttemptAt   DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastFailureCode String?   @map("last_failure_code") @db.VarChar(64)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt, id], map: "product_image_cleanups_created_id_idx")
  @@map("product_image_cleanups")
}

model PriceDisplaySetting {
  id        Int              @id(map: "price_display_settings_pkey") @default(1) @db.SmallInt
  unit      PriceDisplayUnit @default(TOMAN)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("price_display_settings")
}
