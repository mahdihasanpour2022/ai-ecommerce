{
  "name": "automotive-commerce",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @automotive-commerce/storefront dev",
    "build": "turbo run build",
    "build:all": "turbo run build",
    "start": "yarn workspace @automotive-commerce/storefront start",
    "lint": "turbo run lint",
    "lint:all": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "2.10.12"
  },
  "packageManager": "yarn@1.22.22"
}
