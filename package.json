{
  "name": "automotive-commerce",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @automotive-commerce/storefront dev",
    "build": "turbo run build",
    "build:all": "turbo run build",
    "start": "yarn workspace @automotive-commerce/storefront start",
    "lint": "turbo run lint",
    "lint:all": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \".github/**/*.{yaml,yml}\" \"apps/**/*.{css,json,js,mjs,ts,tsx}\" \"packages/**/*.{css,json,js,mjs,ts,tsx}\" \"scripts/**/*.{css,json,js,mjs,ts,tsx}\" \"*.{json,js,mjs,ts,yaml,yml}\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \".github/**/*.{yaml,yml}\" \"apps/**/*.{css,json,js,mjs,ts,tsx}\" \"packages/**/*.{css,json,js,mjs,ts,tsx}\" \"scripts/**/*.{css,json,js,mjs,ts,tsx}\" \"*.{json,js,mjs,ts,yaml,yml}\" --no-error-on-unmatched-pattern",
    "db:config": "node scripts/local-postgres.mjs config",
    "db:start": "node scripts/local-postgres.mjs start",
    "db:status": "node scripts/local-postgres.mjs status",
    "db:health": "node scripts/local-postgres.mjs health",
    "db:verify": "node scripts/local-postgres.mjs verify",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:reset:dev": "node scripts/local-postgres.mjs reset automotive_dev",
    "db:reset:test": "node scripts/local-postgres.mjs reset automotive_test"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.12"
  },
  "packageManager": "yarn@1.22.22"
}
